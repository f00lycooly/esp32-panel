# Site config + secrets (ship only the .example files)
user-config.yaml
secrets.yaml
secrets.yaml.bak

# ESPHome build artefacts
.esphome/
build/

# Python
__pycache__/
*.pyc

# Original third-party artwork (only the derived raster assets are shipped)
glados_by_browen2o*.png

# Optional site-specific deploy targets (see Makefile tail)
deploy.local.mk

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key

# Bead exports are NOT tracked in this public repo: they carry private infra
# details (LAN IPs, internal hostnames, owner email). The central Dolt server
# is the beads source of truth; the local JSONL is a passive export.
.beads/*.jsonl
